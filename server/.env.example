# Server Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Frontend URL (CORS + email links) ─────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Gmail SMTP (Nodemailer) ───────────────────────────────────────────────────
# EMAIL_USER  = your full Gmail address (e.g. yourapp@gmail.com)
# EMAIL_PASS  = a Gmail App Password — NOT your Google account password.
#
# How to generate a Gmail App Password (takes ~1 minute):
#   1. Go to https://myaccount.google.com/security
#   2. Enable "2-Step Verification" if not already on.
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Select app: "Mail" | device: "Other (custom name)" → type "ThreadHaus"
#   5. Click Generate — copy the 16-character password (no spaces).
#   6. Paste it as EMAIL_PASS below.
#
# NOTE: If you see "Username and Password not accepted" errors, ensure:
#   - 2-Step Verification IS enabled on the Google account.
#   - You are using the App Password (16 chars), not your login password.
#   - "Less secure app access" is NOT needed when using App Passwords.
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
