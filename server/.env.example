# Server Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Frontend URL (CORS + reset/verify email links) ────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Gmail OAuth2 (Nodemailer) ─────────────────────────────────────────────────
#
# WHY OAuth2 instead of App Password?
#   Render's free tier and most cloud platforms block outbound SMTP ports
#   (25, 465, 587) at the firewall level. OAuth2 authenticates over HTTPS
#   so it is never blocked.
#
# ONE-TIME SETUP (~5 minutes):
#
#   STEP 1 — Create a Google Cloud project
#     • Go to https://console.cloud.google.com/
#     • Click "Select a project" → "New Project" → name it (e.g. ThreadHaus)
#     • Click "Create"
#
#   STEP 2 — Enable the Gmail API
#     • Go to "APIs & Services" → "Enable APIs and Services"
#     • Search "Gmail API" → click it → "Enable"
#
#   STEP 3 — Configure OAuth consent screen
#     • Go to "APIs & Services" → "OAuth consent screen"
#     • Choose "External" → Fill in App name (ThreadHaus), your email → Save
#     • Under "Test users" → Add your Gmail address → Save
#
#   STEP 4 — Create OAuth 2.0 credentials
#     • Go to "APIs & Services" → "Credentials"
#     • Click "Create Credentials" → "OAuth client ID"
#     • Application type: "Web application"
#     • Add Authorized redirect URI: https://developers.google.com/oauthplayground
#     • Click "Create" → Note down Client ID and Client Secret
#
#   STEP 5 — Get your Refresh Token (using OAuth Playground)
#     • Go to https://developers.google.com/oauthplayground
#     • Click the ⚙ (gear/settings) icon in the top right
#     • Check "Use your own OAuth credentials"
#     • Paste your Client ID and Client Secret → Close
#     • In the left panel, scroll to "Gmail API v1"
#     • Select scope: https://mail.google.com/ → "Authorize APIs"
#     • Sign in with your Gmail account → Allow access
#     • Click "Exchange authorization code for tokens"
#     • Copy the "Refresh token" value
#
#   STEP 6 — Add to .env (and to Render environment variables)
#     EMAIL_USER           = your Gmail address
#     GMAIL_CLIENT_ID      = from Step 4
#     GMAIL_CLIENT_SECRET  = from Step 4
#     GMAIL_REFRESH_TOKEN  = from Step 5
#
EMAIL_USER=your_gmail@gmail.com
GMAIL_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
